# Dockerfile.cpu — T0 course environment: compilers, CMake, perf, uv + the locked Python env. No GPU.
# Build: docker build -f env/Dockerfile.cpu -t s2s-cpu .        Run: docker run --rm -it -v $PWD:/work s2s-cpu
# Pin the base by digest in your fork: docker pull ubuntu:24.04 && docker inspect --format '{{index .RepoDigests 0}}' ubuntu:24.04
FROM ubuntu:24.04
ARG DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
      build-essential clang cmake ninja-build git curl ca-certificates python3 python3-venv \
      linux-tools-generic valgrind \
    && rm -rf /var/lib/apt/lists/*
COPY --from=ghcr.io/astral-sh/uv:0.5 /uv /usr/local/bin/uv
WORKDIR /work
COPY pyproject.toml uv.lock ./
RUN uv sync --frozen --no-install-project
ENV PATH=/work/.venv/bin:$PATH
# Run as an unprivileged user by default (perf needs --cap-add PERFMON or --privileged when you want it).
RUN useradd -m s2s && chown -R s2s /work
USER s2s
CMD ["bash"]
