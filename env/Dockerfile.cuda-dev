# Dockerfile.cuda-dev — T2 kernel development: CUDA toolkit (nvcc, Nsight CLIs), CMake, Python + torch extra.
# Build: docker build -f env/Dockerfile.cuda-dev -t s2s-cuda-dev .
# Run:   docker run --rm -it --gpus all -v $PWD:/work s2s-cuda-dev
#        (ncu needs counter access: add --cap-add SYS_ADMIN, or set NVreg_RestrictProfilingToAdminUsers=0 on the host)
# The host driver must be new enough for this CUDA version (NVIDIA's CUDA compatibility matrix; P3.1 §2).
FROM nvidia/cuda:12.6.3-devel-ubuntu24.04
ARG DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
      cmake ninja-build git curl ca-certificates python3 python3-venv \
    && rm -rf /var/lib/apt/lists/*
COPY --from=ghcr.io/astral-sh/uv:0.5 /uv /usr/local/bin/uv
WORKDIR /work
COPY pyproject.toml uv.lock ./
RUN uv sync --frozen --no-install-project --extra torch
ENV PATH=/work/.venv/bin:$PATH
# Non-root by default; for `ncu` either run the container with --cap-add SYS_ADMIN or allow non-admin profiling on the host.
RUN useradd -m s2s && chown -R s2s /work
USER s2s
CMD ["bash"]
